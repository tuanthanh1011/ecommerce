# Garage config for LOCAL DEV (docker-compose.yml). Single-node, no
# replication — fine for dev/small-VPS use, NOT a substitute for the daily
# R2 backup (see apps/api backups module). Mirrors the upstream quickstart:
# https://garagehq.deuxfleurs.fr/documentation/quick-start/
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_WITH_$(openssl rand -hex 32)"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"
root_domain = ".s3.garage.localhost"

[s3_web]
# "*.localhost" always resolves to 127.0.0.1 in modern browsers/OS resolvers,
# so this needs zero local DNS setup — e.g. http://media.web.garage.localhost:3902
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "REPLACE_WITH_$(openssl rand -base64 32)"
metrics_token = "REPLACE_WITH_$(openssl rand -base64 32)"
