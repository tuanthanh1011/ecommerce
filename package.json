{
  "name": "st-cms",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "seed": "turbo run seed",
    "seed:demo": "npm run seed:demo -w api",
    "reset-admin": "npm run reset-admin -w api",
    "migration:generate": "npm run migration:generate -w api --",
