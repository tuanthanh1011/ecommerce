# Single .env for the whole monorepo — copy to `.env` and fill in real
# values. apps/api reads this via ConfigModule (see apps/api/src/config/root-env.ts);
# apps/web reads it via next.config.ts. No per-app .env files anymore.

# ── apps/api ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Docker network hostname is `postgres`; for local (non-Docker) dev point this
# at localhost:5433 instead (see docker-compose.yml port mapping).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/st_cms

JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Garage (self-hosted S3-compatible storage, see docker-compose.yml) —
# primary upload target. GARAGE_ACCESS_KEY_ID/SECRET must match
# infra/garage/garage.toml's bucket/key (see infra/garage/garage.toml.example
# and README "Garage" section for how those are generated).
GARAGE_REGION=garage
GARAGE_ACCESS_KEY_ID=replace-with-generated-access-key-id
GARAGE_SECRET_ACCESS_KEY=replace-with-generated-secret-access-key
GARAGE_BUCKET_NAME=media
GARAGE_INTERNAL_ENDPOINT=http://garage:3900
GARAGE_PUBLIC_ENDPOINT=http://localhost:3900
GARAGE_PUBLIC_BASE_URL=http://media.web.garage.localhost:3902

# Cloudflare R2 — backup target ONLY now (daily DB + media backup, see
# modules/backups). No longer used for live uploads/serving.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BACKUP_BUCKET_NAME=st-cms-backups
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
BACKUP_RETENTION_COUNT=3
BACKUP_CRON=0 3 * * *

CORS_ORIGIN=http://localhost:3000

RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Lock an admin account after N consecutive wrong passwords, for M minutes
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

REQUEST_LOG_RETENTION_DAYS=30
MAX_UPLOAD_SIZE_BYTES=15728640

SEED_ADMIN_EMAIL=admin@st-coffee.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin

# ── apps/web ──────────────────────────────────────────────────────────────
# Baked into the static export at build time (see apps/web/next.config.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
